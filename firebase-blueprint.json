{
  "entities": {
    "ClassConfig": {
      "title": "ClassConfig",
      "description": "Elementary school class settings and shared password hash",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "maxLength": 64 },
        "schoolYear": { "type": "string", "maxLength": 10 },
        "grade": { "type": "number" },
        "classNum": { "type": "number" },
        "classPasswordHash": { "type": "string", "maxLength": 128 },
        "className": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["classId", "schoolYear", "grade", "classNum", "classPasswordHash"]
    },
    "Student": {
      "title": "Student",
      "description": "Student profile, typing progress, incorrect words and statistics",
      "type": "object",
      "properties": {
        "studentKey": { "type": "string", "maxLength": 64 },
        "schoolYear": { "type": "string", "maxLength": 10 },
        "grade": { "type": "number" },
        "classNum": { "type": "number" },
        "studentNumber": { "type": "number" },
        "studentName": { "type": "string", "maxLength": 32 },
        "passwordHash": { "type": "string", "maxLength": 128 },
        "highestWpm": { "type": "number" },
        "highestAccuracy": { "type": "number" },
        "clearedStage": { "type": "number" },
        "totalAttempts": { "type": "number" },
        "incorrectWords": { "type": "array" },
        "mistakeKeys": { "type": "object" },
        "lastPracticedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentKey", "schoolYear", "grade", "classNum", "studentNumber", "studentName", "passwordHash"]
    },
    "TypingRecord": {
      "title": "TypingRecord",
      "description": "History of individual student typing test attempts and typo analysis",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "studentKey": { "type": "string", "maxLength": 64 },
        "studentName": { "type": "string", "maxLength": 32 },
        "stage": { "type": "number" },
        "stageTitle": { "type": "string", "maxLength": 64 },
        "mode": { "type": "string", "maxLength": 32 },
        "cpm": { "type": "number" },
        "wpm": { "type": "number" },
        "accuracy": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "mistakeCount": { "type": "number" },
        "mistakeKeys": { "type": "array" },
        "incorrectWords": { "type": "array" },
        "passed": { "type": "boolean" },
        "aiFeedback": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "studentKey", "stage", "cpm", "accuracy"]
    },
    "Evaluation": {
      "title": "Evaluation",
      "description": "Process-based student evaluation generated by AI and reviewed/approved by teacher",
      "type": "object",
      "properties": {
        "studentKey": { "type": "string", "maxLength": 64 },
        "studentName": { "type": "string", "maxLength": 32 },
        "grade": { "type": "number" },
        "classNum": { "type": "number" },
        "studentNumber": { "type": "number" },
        "aiDraft": { "type": "string", "maxLength": 2000 },
        "approvedContent": { "type": "string", "maxLength": 2000 },
        "teacherNotes": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["draft", "approved"] },
        "approvedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentKey", "studentName", "aiDraft", "status"]
    },
    "CustomText": {
      "title": "CustomText",
      "description": "AI-generated or teacher customized practice sets for 4th grade curriculum",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "topic": { "type": "string", "maxLength": 128 },
        "stage": { "type": "number" },
        "title": { "type": "string", "maxLength": 128 },
        "items": { "type": "array" },
        "createdBy": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "topic", "stage", "title", "items"]
    },
    "TestDoc": {
      "title": "TestDoc",
      "description": "Connection test document for health checks",
      "type": "object",
      "properties": {
        "testId": { "type": "string", "maxLength": 64 },
        "message": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string" }
      },
      "required": ["testId"]
    }
  },
  "firestore": {
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/ClassConfig" },
      "description": "Class configuration and class password"
    },
    "/students/{studentKey}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student profiles, stats, and typo notebook"
    },
    "/typingRecords/{recordId}": {
      "schema": { "$ref": "#/entities/TypingRecord" },
      "description": "Typing exercise history and metrics"
    },
    "/evaluations/{studentKey}": {
      "schema": { "$ref": "#/entities/Evaluation" },
      "description": "Process-based evaluations with AI drafts and teacher approvals"
    },
    "/customTexts/{textId}": {
      "schema": { "$ref": "#/entities/CustomText" },
      "description": "Teacher custom or AI generated practice sentences"
    },
    "/test/{testId}": {
      "schema": { "$ref": "#/entities/TestDoc" },
      "description": "Database connection and CRUD verification"
    }
  }
}
